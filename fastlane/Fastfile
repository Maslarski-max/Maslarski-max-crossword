default_platform(:android)

platform :android do
  desc "Unit tests + Android lint"
  lane :test do
    gradle(task: ":app:testDebugUnitTest :app:lintDebug")
  end

  desc "Build a signed release App Bundle (.aab). Options: version_code:, version_name:"
  lane :build_aab do |options|
    ensure_signing!
    properties = {}
    properties["versionCode"] = options[:version_code].to_s if options[:version_code]
    properties["versionName"] = options[:version_name].to_s if options[:version_name]
    gradle(task: ":app:bundleRelease", properties: properties)
    aab = lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]
    UI.success("Signed bundle: #{aab}")
    aab
  end

  desc "Build and upload to the Play internal testing track as a draft"
  lane :internal do |options|
    aab = build_aab(options)
    upload_to_play_store(
      track: "internal",
      aab: aab,
      release_status: "draft",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Promote the latest internal build. Options: to: (alpha|beta|production), rollout: (0.0-1.0)"
  lane :promote do |options|
    to = options.fetch(:to, "production")
    rollout = options[:rollout]
    upload_to_play_store(
      track: "internal",
      track_promote_to: to,
      rollout: rollout&.to_s,
      release_status: rollout ? "inProgress" : "completed",
      skip_upload_aab: true,
      skip_upload_changelogs: false,
    )
  end

  desc "Upload store listing text from fastlane/metadata (no binary)"
  lane :metadata do
    upload_to_play_store(skip_upload_aab: true, skip_upload_changelogs: true)
  end

  private_lane :ensure_signing! do
    has_file = File.exist?(File.expand_path("../keystore.properties", __dir__))
    has_env = ENV["CROSSWORD_KEYSTORE_FILE"] && ENV["CROSSWORD_KEYSTORE_PASSWORD"] &&
              ENV["CROSSWORD_KEY_ALIAS"] && ENV["CROSSWORD_KEY_PASSWORD"]
    UI.user_error!("No upload key: create keystore.properties or set CROSSWORD_KEYSTORE_* (see README)") unless has_file || has_env
  end
end
