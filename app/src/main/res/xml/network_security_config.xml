<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. The game itself is offline; network traffic comes from the Firebase and Play SDKs. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
